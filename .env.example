# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/rexbase
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Spring Admin (Actuator / Basic Auth) ────────────────────────────────────
SPRING_ADMIN_USER=admin
SPRING_ADMIN_PASSWORD=change-me

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use a strong random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET_KEY=change-me

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_JWKS_URL=https://auth.dev.commodis.de/realms/grant-thornton/protocol/openid-connect/certs

# ─── SMTP / Mail ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=your-email@gmail.com

# ─── Hetzner Object Storage (S3) ─────────────────────────────────────────────
HETZNER_S3_ACCESS_KEY=your-access-key
HETZNER_S3_SECRET_KEY=your-secret-key

# ─── D-velop Integration ─────────────────────────────────────────────────────
DVELOP_API_BASE_URL=https://gtdtest.d-velop.cloud
DVELOP_API_TRANSFERS_PATH=/smartinvoice/api/v1/transfers
DVELOP_API_INTEGRATION_KEY=your-integration-key
INVOICE_SYNC_ENABLED=false

# ─── Team Event Job ──────────────────────────────────────────────────────────
TEAMEVENT_JOB_ENABLED=false
TEAMEVENT_JOB_CRON=0 0 14 * * *
ZONE=Asia/Kolkata
